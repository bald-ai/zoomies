.DS_Store

# SwiftPM / Swift compiler build output (includes index store databases like data.mdb).
.build/
dist/
.tmp_cache/
.tmp_home/

# Xcode / SourceKit / derived artifacts (optional, but usually safe to ignore).
DerivedData/

# Xcode user-specific state.
xcuserdata/
*.xcuserstate
*.xccheckout
*.xcscmblueprint

# Logs.
*.log

# Python bytecode (no Python is part of this project).
__pycache__/
*.pyc

# Disposable verification output; manual runs clean it up.
/Dev/code-quality-metrics-local.json
/.verification-session/

# Local credentials; sanitized examples remain versioned.
.env
.env.*
!.env.example
!.env.*.example
!.env.sample
!.env.*.sample
!.env.template
!.env.*.template

# Local IDE state.
.idea/workspace.xml
.idea/tasks.xml
.idea/caches/

# Generated verification evidence; campaign notes remain versioned.
/Dev/quality-campaign/evidence/
